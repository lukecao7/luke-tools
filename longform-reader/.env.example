# Copy to .env.local. Keep the API key on this computer only.
# Claim the Pro benefit for your Personal API organization, then use its key.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
# Standard speed (service_tier=default); response storage is disabled.
READING_SPACES=1
APP_PASSWORD=
APP_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
OCR_ENGINE=auto
# Optional path to a Python environment with ocr/requirements.txt installed.
OCR_PYTHON=

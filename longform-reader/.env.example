# Local processing uses the signed-in Codex CLI; no API key is needed.
CODEX_MODEL=gpt-6.1-sol
CODEX_REASONING_EFFORT=medium
# Standard speed is explicitly selected (service_tier=default).
# Optional executable override. On macOS the desktop app CLI is preferred.
# CODEX_BIN=/absolute/path/to/codex
READING_SPACES=1
APP_PASSWORD=
APP_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
OCR_ENGINE=auto
# Optional path to a Python environment with ocr/requirements.txt installed.
OCR_PYTHON=

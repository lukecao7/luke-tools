# Optional single-user local DeepSeek mode only. Online mode always requires
# the browser's own key and never falls back to this shared environment key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Exercise the online browser-owned workspace and key flow on a local server.
USER_OWNED_KEYS=0
# Local Codex testing (Vercel continues to use DeepSeek).
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium
APP_PASSWORD=
APP_SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=
OCR_ENGINE=auto
# Optional path to a Python environment with ocr/requirements.txt installed.
OCR_PYTHON=
